---
import "destyle.css";
import "@fontsource-variable/fredoka/wght.css";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>🐶Random Dog🐶</title>
    <style>
      body {
        font-family: "Fredoka Variable", sans-serif;
        margin: 0 auto;
      }
      img {
        width: 100%;
        max-width: 100%;
        height: auto;
      }

      h1 {
        font-size: 3rem;
        margin: 1rem 0;
        font-weight: 700;
        text-align: center;
      }

      h2 {
        font-size: 2rem;
        font-weight: 600;
        align-self: center;
      }

      .itembox {
        border: 1px solid #000;
        padding: 1rem;
        width: fit-content;
        border-radius: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: 16px 16px 0 0 #000;
        margin: 0 auto;
      }

      #dog-img {
        max-width: 500px;
        border-radius: 16px;
        overflow: hidden;
      }

      #dog-btn {
        padding: 1rem;
        background-color: rgb(255, 196, 119);
        transition: 0.5s;
        align-self: flex-start;
        border-radius: 1rem;

        &:hover {
          background-color: rgb(255, 163, 44);
          transform: translateY(5px);
        }
      }
    </style>
  </head>
  <body>
    <h1>🐶Random Dog🐶</h1>
    <section class="itembox">
      <h2>What a good boy!</h2>
      <div id="dog-img">
        <img src="" alt="ランダムな犬" />
      </div>
      <button id="dog-btn">Come here!</button>
    </section>

    <button class="dog-button" data-dog="コーギー">コーギー</button>
    <button class="dog-button" data-dog="柴犬">柴犬</button>
    <button class="dog-button" data-dog="ラブラドール">ラブラドール</button>

    <p id="message">犬を選んでください</p>
    <script>
      const response = await fetch("https://dog.ceo/api/breeds/image/random");
      const data = await response.json();
      console.log(data);

      const btn = document.getElementById("dog-btn");
      const img = document.querySelector("#dog-img img");

      img.src = data.message;

      btn.addEventListener("click", async () => {
        const response = await fetch("https://dog.ceo/api/breeds/image/random");
        const data = await response.json();

        img.src = data.message;
      });

      const buttons = document.querySelectorAll(".dog-button");
      const message = document.querySelector("#message");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          message.textContent = `${button.dataset.dog}が選ばれました！`;
        });
      });
    </script>
  </body>
</html>
